[Unit]
Description=Exam Jingga - nilai otomatis sesi ujian yang waktunya habis
After=network.target postgresql.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/exam-jingga
EnvironmentFile=/opt/exam-jingga/.env
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"
ExecStart=/opt/exam-jingga/.venv/bin/python manage.py grade_expired_sessions
